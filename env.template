# ============================================
# LinkLore 生产环境变量配置文件模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env
# 2. 替换所有占位符为实际值
# 3. 确保所有必需项都已填写
# ============================================

# ============================================
# PostgreSQL 数据库配置
# ============================================
# 如果使用 Docker 内的 PostgreSQL（推荐）
POSTGRES_DB=linklore
POSTGRES_USER=linklore_user
POSTGRES_PASSWORD=请设置强密码（至少16位，建议包含大小写字母、数字和特殊字符）

# 如果使用外部 PostgreSQL（如阿里云 RDS）
# DATABASE_URL=postgresql://用户名:密码@RDS地址:5432/linklore?sslmode=require

# ============================================
# Redis 配置
# ============================================
# 如果使用 Docker 内的 Redis（推荐）
# 如果设置了密码，请同时设置 REDIS_URL
REDIS_PASSWORD=你的Redis密码（可选，建议设置强密码）

# 如果使用外部 Redis（如阿里云 Redis）
# REDIS_URL=redis://:密码@Redis地址:6379/0

# ============================================
# 会话密钥（必需，至少32字符）
# ============================================
# 生成方式：在终端执行
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 或者使用在线工具生成32位以上的随机字符串
SESSION_SECRET=请生成32位随机字符串（必需！）

# ============================================
# 阿里云 OSS 配置（必需）
# ============================================
# 地域列表：
# - oss-cn-hangzhou（华东1-杭州）
# - oss-cn-shanghai（华东2-上海）
# - oss-cn-beijing（华北2-北京）
# - oss-cn-shenzhen（华南1-深圳）
# - oss-cn-hongkong（香港）
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=你的AccessKey ID
OSS_ACCESS_KEY_SECRET=你的AccessKey Secret
OSS_BUCKET=你的Bucket名称

# ============================================
# AI 配置（可选，根据需求调整）
# ============================================
# AI 提供商：openai, qwen, siliconflow 等
AI_DEFAULT_PROVIDER=openai
AI_ALLOWED_PROVIDERS=openai,qwen
AI_FALLBACK_PROVIDER=qwen

# AI 成本限制（单位：美分）
# AI_MONTHLY_USER_CAP_CENTS: 每月用户限额（500美分 = $5）
# AI_JOB_COST_LIMIT_CENTS: 单次任务限额（50美分 = $0.5）
AI_MONTHLY_USER_CAP_CENTS=500
AI_JOB_COST_LIMIT_CENTS=50

# ============================================
# 队列配置
# ============================================
# 并发处理数量（根据服务器性能调整）
QUEUE_CONCURRENCY=1

# ============================================
# 文件上传配置
# ============================================
# 最大文件大小（MB）
MAX_FILE_SIZE_MB=20

# 允许的文件扩展名（逗号分隔）
ALLOWED_EXT=doc,docx,txt,md

# ============================================
# 生产环境配置
# ============================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# 应用 URL（必需！用于 Server Actions）
# 请替换为你的实际域名
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================
# 可选配置
# ============================================

# Sentry 监控（可选）
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# SMTP 邮件配置（可选，用于发送邮件）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@your-domain.com

# ============================================
# 配置检查清单
# ============================================
# [ ] POSTGRES_PASSWORD 已设置（至少16位）
# [ ] SESSION_SECRET 已生成（至少32位）
# [ ] OSS_ACCESS_KEY_ID 已填写
# [ ] OSS_ACCESS_KEY_SECRET 已填写
# [ ] OSS_BUCKET 已填写
# [ ] NEXT_PUBLIC_APP_URL 已替换为实际域名
# [ ] REDIS_PASSWORD 已设置（如使用密码）
# ============================================

